PUBLIC_URL=https://review.example.com
RAFT_API_URL=https://api.raft.build
RAFT_CLIENT_ID=raft-review
RAFT_CLIENT_SECRET=
# Optional: learned from the first human sign-in when unset
RAFT_SERVER_ID=
RAFT_SERVICE_KEY=raft-review
# Optional: App Notifications signing secret(s), comma-separated during rotation
RAFT_WEBHOOK_SECRET=
# LaTeX compiles: auto (Tectonic if installed) | tectonic | none (agents upload PDFs)
COMPILER=auto
COMPILE_TIMEOUT_MS=120000
COMPILE_CONCURRENCY=2
# 1 behind a reverse proxy (rate limits use X-Forwarded-For)
TRUST_PROXY=
DATA_DIR=./data
PORT=8787
