{
  "name": "raft-review",
  "version": "0.1.0",
  "private": true,
  "description": "Google Docs-style document review with Raft agents: highlight, comment, agent replies and suggested edits you accept or reject.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "RAFT_REVIEW_DEV_LOGIN=1 node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "^5.8.3"
  }
}
